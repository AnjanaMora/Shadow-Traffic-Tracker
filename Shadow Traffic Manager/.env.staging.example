# =============================================================================
# Shadow Traffic — Staging Environment Configuration (.env.staging)
# =============================================================================
# Used for pre-production integration testing, end-to-end load testing, and
# verification against production-like telemetry loads.
# =============================================================================

ENVIRONMENT=staging
LOG_LEVEL=info
LOG_FORMAT_JSON=true

# --- TimescaleDB Staging Storage ---
POSTGRES_USER=shadow_staging
POSTGRES_PASSWORD=staging_secret_password_456
POSTGRES_DB=shadow_traffic_staging
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shadow_staging:staging_secret_password_456@timescaledb:5432/shadow_traffic_staging
DATABASE_POOL_SIZE=15

# --- Core API Gateway (Backend) ---
BACKEND_PORT=8000
DEFAULT_API_KEY=shadow-staging-key-456
ALLOWED_API_KEYS=shadow-staging-key-456,shadow-test-runner-789
RATE_LIMIT_REQUESTS_PER_MINUTE=240
CORS_ALLOWED_ORIGINS=*

# --- Alerting & Notification Channels ---
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/STAGING_WEBHOOK_TEST
ALERT_COOLDOWN_SECONDS=60
HYSTERESIS_CONSECUTIVE_CHECKS=2

# --- Prediction Engine ---
PREDICTION_ENGINE_URL=http://prediction-engine:8001
PREDICTION_PORT=8001
FORECAST_HORIZON_MINUTES=20
BASELINE_EWMA_ALPHA=0.30
LATENCY_CRITICAL_THRESHOLD_MS=400.0
ERROR_RATE_CRITICAL_THRESHOLD_PERCENT=5.0

# --- Dashboard Frontend ---
DASHBOARD_PORT=3000

# --- Telemetry Collector Agent (Staging Mode) ---
SITE_ID=staging-ecommerce-test
COLLECTOR_MODE=simulate
REPORT_INTERVAL_SECONDS=3.0
SIM_SPEED_MULTIPLIER=1.0
