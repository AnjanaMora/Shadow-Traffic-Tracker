# =============================================================================
# Shadow Traffic — Production Environment Configuration (.env.production)
# =============================================================================
# SECURITY WARNING: Replace ALL default secrets, passwords, and API keys before
# deploying to a production VPS or container cluster.
# =============================================================================

# Deployment Environment Profile
ENVIRONMENT=production
LOG_LEVEL=warning
LOG_FORMAT_JSON=true

# --- TimescaleDB Production Storage ---
# Use a strong, random password (e.g. openssl rand -hex 24)
POSTGRES_USER=shadow_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_RANDOM_PASSWORD_IN_PRODUCTION
POSTGRES_DB=shadow_traffic_prod
# Database port is internal-only; not exposed on host interface in production
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shadow_admin:CHANGE_ME_TO_A_SECURE_RANDOM_PASSWORD_IN_PRODUCTION@timescaledb:5432/shadow_traffic_prod
DATABASE_POOL_SIZE=30

# --- Core API Gateway (Backend) ---
BACKEND_PORT=8000
DEFAULT_API_KEY=CHANGE_ME_TO_A_CRYPTOGRAPHIC_COLLECTOR_KEY
ALLOWED_API_KEYS=CHANGE_ME_TO_A_CRYPTOGRAPHIC_COLLECTOR_KEY,CHANGE_ME_SECONDARY_KEY
RATE_LIMIT_REQUESTS_PER_MINUTE=120
CORS_ALLOWED_ORIGINS=https://dashboard.shadowtraffic.yourdomain.com,https://shadowtraffic.yourdomain.com

# --- Alerting & Notification Channels ---
# Webhook URL for production incident dispatch (e.g. PagerDuty, Slack, OpsGenie)
ALERT_WEBHOOK_URL=your-slack-or-pagerduty-webhook-url-here
ALERT_COOLDOWN_SECONDS=180
HYSTERESIS_CONSECUTIVE_CHECKS=2
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_RECIPIENT=devops-alerts@yourdomain.com

# --- Prediction Engine Hyperparameters ---
PREDICTION_ENGINE_URL=http://prediction-engine:8001
PREDICTION_PORT=8001
FORECAST_HORIZON_MINUTES=20
BASELINE_EWMA_ALPHA=0.25
LATENCY_CRITICAL_THRESHOLD_MS=500.0
ERROR_RATE_CRITICAL_THRESHOLD_PERCENT=5.0

# --- React Dashboard Frontend ---
DASHBOARD_PORT=80
VITE_BACKEND_URL=
VITE_BACKEND_WS_URL=

# --- Production Telemetry Collector Agent ---
SITE_ID=prod-main-cluster
# Mode options: 'tail-log' (Nginx/Apache), 'scrape-prometheus', or 'simulate'
COLLECTOR_MODE=tail-log
LOG_FILE_PATH=/var/log/nginx/access.log
PROMETHEUS_METRICS_URL=
REPORT_INTERVAL_SECONDS=5.0
