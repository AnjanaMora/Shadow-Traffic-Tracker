# =============================================================================
# Shadow Traffic — Environment Configuration (.env)
# =============================================================================
# Copy this file to .env and adjust variables as needed.
# For environment-specific presets, see:
#   - .env.production.example  (Hardened production configuration)
#   - .env.staging.example     (Pre-production integration testing)
# =============================================================================

# Deployment Environment Profile ('development', 'staging', or 'production')
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT_JSON=true

# --- TimescaleDB / PostgreSQL Settings ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shadow_traffic
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shadow_traffic
DATABASE_POOL_SIZE=20

# --- Core API Gateway (Backend) ---
BACKEND_PORT=8000
DEFAULT_API_KEY=shadow-dev-key-123
ALLOWED_API_KEYS=shadow-dev-key-123,prod-collector-key-999
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=*

# --- Alerting & Webhooks ---
# Webhook URL for incident dispatch (e.g. Slack incoming webhook, PagerDuty)
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=60
HYSTERESIS_CONSECUTIVE_CHECKS=2

# --- Prediction Engine ---
PREDICTION_ENGINE_URL=http://localhost:8001
PREDICTION_PORT=8001
FORECAST_HORIZON_MINUTES=20
BASELINE_EWMA_ALPHA=0.35
LATENCY_CRITICAL_THRESHOLD_MS=300.0
ERROR_RATE_CRITICAL_THRESHOLD_PERCENT=5.0

# --- Dashboard Frontend ---
DASHBOARD_PORT=3000
VITE_BACKEND_URL=http://localhost:8000
VITE_BACKEND_WS_URL=ws://localhost:8000

# --- Telemetry Collector Agent ---
SITE_ID=shadow-ecommerce-prod
COLLECTOR_MODE=simulate
REPORT_INTERVAL_SECONDS=3.0
SIM_SPEED_MULTIPLIER=1.0
SIM_CONGESTION_DELAY_SECONDS=60.0
SIM_CONGESTION_DURATION_SECONDS=300.0
SIM_CONGESTION_SEVERITY=3.5
